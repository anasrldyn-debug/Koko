
name: Extract SE Pool Free ZIP

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract ZIP file
        run: |
          unzip -o SEPoolFree-source.zip
          cp -R SEPoolFree/. .
          rm -rf SEPoolFree
          rm -f SEPoolFree-source.zip

      - name: Commit extracted files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Extract SE Pool Free project" || echo "No changes"
          git push
